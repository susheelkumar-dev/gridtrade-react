{
  "schemaVersion": "1.0",
  "kind": "display",
  "id": "assets.generation-assets",
  "name": "GenerationAssetSummary",
  "title": "Generation Assets",
  "description": "Search, filter and manage generation assets.",
  "type": "summary",
  "module": "assets",
  "route": "assets/generation-assets",
  "icon": "x-fa fa-solar-panel",
  "openMode": "tab",
  "entity": "GenerationAsset",
  "menu": {
    "id": "assets.generation-assets",
    "title": "Generation Assets",
    "parent": "assets",
    "icon": "x-fa fa-industry",
    "sortOrder": 10,
    "params": {},
    "requiredPermissions": [],
    "enabled": true
  },
  "folders": [
    {
      "id": "assets",
      "title": "Assets",
      "icon": "x-fa fa-solar-panel",
      "sortOrder": 55
    }
  ],
  "permissions": {
    "required": [],
    "actions": {}
  },
  "summary": {
    "columns": [
      {
        "field": "code",
        "width": 110,
        "sortable": true,
        "filter": true,
        "hidden": false
      },
      {
        "field": "name",
        "flex": 1.4,
        "sortable": true,
        "filter": true,
        "hidden": false
      },
      {
        "field": "assetType",
        "width": 120,
        "sortable": true,
        "filter": true,
        "hidden": false,
